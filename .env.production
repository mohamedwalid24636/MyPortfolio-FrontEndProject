# Production build configuration, committed on purpose.
#
# Vite inlines VITE_* variables at build time, so these values must be available to the GitHub
# Actions build. Everything here is public: it is baked into the JavaScript bundle and served to
# every visitor anyway. No secrets belong in this file.
#
# There is no proxy in production. A relative "/api" would resolve against the Pages origin, so the
# API is addressed by its absolute origin.
VITE_API_BASE_URL=https://mohamedwalid.runasp.net/api

# Origin for the scheme-less attachment URLs the API returns, e.g.
# "mohamedwalid.runasp.net/Files/images/profile/x.jpg". Derived from VITE_API_BASE_URL when unset.
VITE_ASSET_ORIGIN=https://mohamedwalid.runasp.net

# Project sites are served from https://<user>.github.io/<repo>/. A user or organisation site would
# use "/" instead, as would local development.
VITE_BASE_PATH=/MyPortfolio-FrontEndProject

# Only read by `npm run dev` / `npm run preview`; it has no effect on the production bundle.
VITE_API_PROXY_TARGET=https://mohamedwalid.runasp.net