# Copy to .env and adjust. See .env for what each value does.

# Origin the browser calls the API on. Must be an ABSOLUTE https origin in production.
VITE_API_BASE_URL=https://mohamedwalid.runasp.net/api

# Origin used to resolve the scheme-less attachment URLs the API returns.
VITE_ASSET_ORIGIN=https://mohamedwalid.runasp.net

# Path the built site is served from ("/" for a user/organisation site or local dev).
VITE_BASE_PATH=/MyPortfolio-FrontEndProject

# Origin the Vite dev/preview proxy forwards /api and /Files to. Local development only.
VITE_API_PROXY_TARGET=http://localhost:5022