# Base URL the browser uses to call the backend.
# "/api" routes through the Vite dev proxy, so no CORS and no certificate handling is needed
# during development. Set an absolute origin (e.g. https://localhost:7067/api) only when the
# frontend is served from somewhere the proxy cannot reach.
VITE_API_BASE_URL=/api

# Origin the Vite dev/preview proxy forwards /api and /Files to. Must match the URL the ASP.NET
# Core API is listening on. Use the https profile when the API runs with UseHttpsRedirection,
# otherwise requests get bounced with a 307 to the https port.
VITE_API_PROXY_TARGET=http://localhost:5022